@base = http://localhost:3000

### Create book
# @name livro
POST {{base}}/livros
Content-Type: application/json

{ "titulo": "O Cortiço", "autor": "Aluísio Azevedo", "isbn": "{{$timestamp}}" }

### Create copy
# @name exemplar
POST {{base}}/exemplares
Content-Type: application/json

{ "livroId": "{{livro.response.body._id}}", "tombo": "BIB-{{$timestamp}}" }

### Create reader
# @name leitor
POST {{base}}/leitores
Content-Type: application/json

{ "nome": "João Souza", "matricula": "{{$timestamp}}", "perfil": "aluno" }

### Book availability (1 copy available)
GET {{base}}/livros/{{livro.response.body._id}}/disponibilidade

### Create loan
# @name emprestimo
POST {{base}}/emprestimos
Content-Type: application/json

{ "leitorId": "{{leitor.response.body._id}}", "exemplarId": "{{exemplar.response.body._id}}" }

### Create loan again (expected 409: copy unavailable)
POST {{base}}/emprestimos
Content-Type: application/json

{ "leitorId": "{{leitor.response.body._id}}", "exemplarId": "{{exemplar.response.body._id}}" }

### Rate before returning (expected 403)
POST {{base}}/livros/{{livro.response.body._id}}/avaliacoes
Content-Type: application/json

{ "leitorId": "{{leitor.response.body._id}}", "nota": 5, "comentario": "Great book" }

### Renew loan
PATCH {{base}}/emprestimos/{{emprestimo.response.body._id}}/renovacao

### Renew again (expected 409: renewal limit)
PATCH {{base}}/emprestimos/{{emprestimo.response.body._id}}/renovacao

### Return loan (fine 0 when on time)
PATCH {{base}}/emprestimos/{{emprestimo.response.body._id}}/devolucao

### Return again (expected 409: already returned)
PATCH {{base}}/emprestimos/{{emprestimo.response.body._id}}/devolucao

### Rate the book
POST {{base}}/livros/{{livro.response.body._id}}/avaliacoes
Content-Type: application/json

{ "leitorId": "{{leitor.response.body._id}}", "nota": 5, "comentario": "Great book" }

### Rate again (expected 409: already rated)
POST {{base}}/livros/{{livro.response.body._id}}/avaliacoes
Content-Type: application/json

{ "leitorId": "{{leitor.response.body._id}}", "nota": 4 }

### Rate with invalid grade (expected 400)
POST {{base}}/livros/{{livro.response.body._id}}/avaliacoes
Content-Type: application/json

{ "leitorId": "{{leitor.response.body._id}}", "nota": 6 }

### Ratings and average of the book
GET {{base}}/livros/{{livro.response.body._id}}/avaliacoes

### Reader history
GET {{base}}/leitores/{{leitor.response.body._id}}/historico

### List active loans
GET {{base}}/emprestimos?status=ativo

### Create loan without body fields (expected 400)
POST {{base}}/emprestimos
Content-Type: application/json

{}

### Create loan with invalid reader (expected 404)
POST {{base}}/emprestimos
Content-Type: application/json

{ "leitorId": "000000000000000000000000", "exemplarId": "{{exemplar.response.body._id}}" }

### Create reader with invalid profile (expected 400)
POST {{base}}/leitores
Content-Type: application/json

{ "nome": "Teste", "matricula": "9999", "perfil": "visitante" }

### Create reader with duplicate registration (expected 409)
POST {{base}}/leitores
Content-Type: application/json

{ "nome": "Outro João", "matricula": "{{leitor.response.body.matricula}}", "perfil": "aluno" }

### Delete book that has copies (expected 409)
DELETE {{base}}/livros/{{livro.response.body._id}}