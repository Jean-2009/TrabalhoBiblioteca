  "type": "module",
  "bugs": {
    "url": "https://github.com/Jean-2009/TrabalhoBiblioteca/issues"
  },
  "homepage": "https://github.com/Jean-2009/TrabalhoBiblioteca#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "mongodb": "^7.9.0"
  }
}
